# Rust
/target

# Node (frontend build tooling)
/web/node_modules

# Generated CSS (rebuilt from web/src/app.css via `npm run build`)
/assets/app.css

# Local runtime data if ever created in-tree
/parental-data

# devt plugin local state/cache
/.devt

# Subagent-driven-development scratch workspace (ledger, briefs, review packages).
# Per-plan artifacts; the record that matters is the git history.
/.superpowers/

# Findings that describe how enforcement can be avoided. Kept out of the public repo
# deliberately — see docs/private/OPERATIONAL-FINDINGS.md.
/docs/private/

# macOS directory metadata. Untracked so far by luck, not by rule.
.DS_Store

# Playwright MCP scratch output (snapshots, console logs, screenshots from UI checks).
/.playwright-mcp/

# Knowledge-graph cache from the graphify tooling. Local scratch, regenerated on demand —
# untracked but noisy in `git status` until it is named here.
/graphify-out/

# Comment-stripped copies of the served files, regenerated by `npm run build` for Tailwind to
# scan. Generated like assets/app.css above, and ignored for the same reason — plus one more: a
# sweep that picked these up would find a second, near-identical copy of both pages and every
# future scanner would have to learn to skip them.
web/.scan/
